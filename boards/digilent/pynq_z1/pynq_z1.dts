/dts-v1/;
#include <xilinx/zynq7000.dtsi>
#include <zephyr/dt-bindings/clock/xlnx-ps7-clkc.h>

#include "pynq_z1-pinctrl.dtsi"

/ {
	model = "Digilent PYNQ-Z1 board";
	compatible = "digilent,zynq-pynq-z1", "xlnx,zynq-7000";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ocm = &ocm_high;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
		};
	};

	sram0: memory@0 {
		compatible = "mmio-sram";
		reg = <0x00000000 DT_SIZE_M(512)>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	clocks = <&clkc XLNX_PS7_CLK_UART0>;
	pinctrl-0 = <&pinctrl_uart0_default>;
	pinctrl-names = "default";
};

/*
 * The board's only Ethernet interface. The GEM driver has no pinctrl support,
 * so the RGMII multiplexing on MIO16..MIO27 and the MDIO multiplexing on
 * MIO52/MIO53 are left to the PS initialization performed by the boot loader.
 * The GEM divides the IO PLL down to the TX clock the link speed needs.
 */
&gem0 {
	status = "okay";
	clocks = <&clkc XLNX_PS7_CLK_IOPLL>;
	phy-handle = <&phy0>;
	pinctrl-0 = <&pinctrl_ethernet0_default>, <&pinctrl_mdio0_default>;
	pinctrl-names = "default";
};

&gem0_mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "okay";
	};
};

/*
 * The QSPI flash the board boots from, on MIO1..MIO6 with the feedback clock on
 * MIO8. The fitted 16 MiB device differs between board revisions, so no flash
 * node is defined here; add one for the device actually fitted, as a child of
 * this node in an application overlay.
 */
&qspi {
	status = "okay";
	clocks = <&clkc XLNX_PS7_CLK_LQSPI>;
};

&swdt {
	status = "okay";
	clocks = <&clkc XLNX_PS7_CLK_SWDT>;
};

/* PS_CLK, from which the three PLLs derive every clock of the processing system */
&clkc {
	status = "okay";
	ps-clk-frequency = <50000000>;
};

&psgpio {
	status = "okay";
};

/dts-v1/;
#include <xilinx/zynq7000.dtsi>

#include "pynq_z1-pinctrl.dtsi"

/ {
	model = "Digilent PYNQ-Z1 board";
	compatible = "digilent,zynq-pynq-z1", "xlnx,zynq-7000";

	chosen {
		zephyr,sram = &sram0;
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,ocm = &ocm_high;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <0>;
		};

		cpu1: cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a9";
			reg = <1>;
		};
	};

	sram0: memory@0 {
		compatible = "mmio-sram";
		reg = <0x00000000 DT_SIZE_M(512)>;
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	clock-frequency = <100000000>;
	pinctrl-0 = <&pinctrl_uart0_default>;
	pinctrl-names = "default";
};

/*
 * The board's only Ethernet interface. The GEM driver has no pinctrl support,
 * so the RGMII multiplexing on MIO16..MIO27 and the MDIO multiplexing on
 * MIO52/MIO53 are left to the PS initialization performed by the boot loader.
 * clock-frequency is the IO PLL frequency, from which the GEM derives its TX
 * clock.
 */
&gem0 {
	status = "okay";
	clock-frequency = <1000000000>;
	phy-handle = <&phy0>;
};

&gem0_mdio {
	status = "okay";

	phy0: ethernet-phy@1 {
		compatible = "ethernet-phy";
		reg = <1>;
		status = "okay";
	};
};

&psgpio {
	status = "okay";
};
